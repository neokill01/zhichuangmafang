.DS_Store
node_modules/
*.log
.workbuddy/

# 淘宝相关素材（本地物料，不入库）
taobao*
推广文案.md

# 运维配置（nginx vhost 等）：不含机密，但属侦察素材（活着的站点 + 技术栈 + 目录结构）
# 只留服务器/本地，不入库。这里忽略常见后缀，但无法穷举所有命名（nginx/default、
# site.nginx 之类就漏得掉），根本办法是别把运维配置放进工作区。
.deploy/
*.conf
*.conf.*
*.conf~
# 放行惯例上应当入库的示例配置，否则 git add 会静默失败
!*example*.conf
!*sample*.conf

# 凭据类：这才是真正要保密的东西，绝不能进这个 public 仓库
.env
.env.*
# 同样放行模板文件
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.ppk
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*_rsa*
*_ed25519*

# deploy.yml 在 runner 仓库根创建的暂存目录（本地复现部署步骤时会留下）
.deploy-stage/
